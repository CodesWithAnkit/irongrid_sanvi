    {
      "id": "cmesnoxft0047p5fzmoe1fuc5",
      "name": "quotation_reminder",
      "subject": "Reminder: Your Quotation {{quotationNumber}} Expires Soon",
      "htmlContent": "\n        <h2>Dear {{customerName}},</h2>\n        <p>This is a friendly reminder that your quotation <strong>{{quotationNumber}}</strong> will expire on {{validUntil}}.</p>\n        <p>To proceed with your order, please contact us as soon as possible.</p>\n        <p>Best regards,<br>Sanvi Machinery Team</p>\n      ",
      "textContent": "Dear {{customerName}}, This is a reminder that your quotation {{quotationNumber}} expires on {{validUntil}}. Please contact us to proceed. Best regards, Sanvi Machinery Team",
      "variables": "[\"customerName\",\"quotationNumber\",\"validUntil\"]",
      "category": "REMINDER",
      "isActive": true,
      "createdAt": "2025-08-26T14:43:29.994Z",
      "updatedAt": "2025-08-26T14:43:29.994Z"
    },
    {
